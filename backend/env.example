NODE_ENV=development
PORT=your port number
DATABASE_URL=your database connection string
CORS_ORIGIN= your frontend origin (e.g., http://localhost:5173)
JWT_SECRET=your secret key for JWT
INSTAGRAM_APP_ID=your Instagram app ID
INSTAGRAM_APP_SECRET=your Instagram app secret
INSTAGRAM_REDIRECT_URI=your Instagram redirect URI (e.g., http://localhost:4000/api/instagram/callback)

INSTAGRAM_TOKEN_ENCRYPTION_KEY="your_generated_64_character_hex_key"